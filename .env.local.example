# PostgreSQL connection string
# Example: postgres://user:password@host:5432/diy-analytics?sslmode=require
DATABASE_URL=

# Optional soft cap (in MB) shown as "storage used" in the workspace/profile
# dashboards. Defaults to 512 if unset.
DATABASE_STORAGE_CAP_MB=512

# Public URL of your deployment (no trailing slash)
# Local dev: http://localhost:3000
# Vercel:    https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authenticates the daily rollup cron (app/api/cron/rollup/route.ts).
# Vercel Cron sends this automatically as "Authorization: Bearer <value>"
# when set on the project — generate with: openssl rand -hex 32
CRON_SECRET=

# AI chat agent (optional) — set exactly one to enable the in-app assistant.
# If multiple are set, priority is: Anthropic > OpenAI > Gemini > Groq > OpenRouter > NVIDIA NIM.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Optional: force a provider instead of relying on the priority order above.
# Ignored unless that provider's API key is also set.
# One of: anthropic | openai | gemini | groq | openrouter | nvidia
AI_PROVIDER=

# Optional model overrides. A provider-specific var wins over AI_MODEL, which
# wins over the built-in default for the active provider.
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-5.1
# GEMINI_MODEL=gemini-3-pro
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=anthropic/claude-sonnet-5
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct
AI_MODEL=

# Optional: point the active provider at a proxy / self-hosted gateway.
AI_BASE_URL=
