# MongoDB connection URI
# Example: mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/diy-analytics
MONGODB_URI=
MONGODB_DATABASE=diy-analytics

# Public URL of your deployment (no trailing slash)
# Local dev: http://localhost:3000
# Vercel:    https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SaaS authentication is database-backed. No global admin password is used.
